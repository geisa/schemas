{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GEISA Sensor v0.9.0",
  "description": "Canonical structure for a GEISA sensor descriptor and generic lower-rate sensor observations.",
  "$defs": {
    "geisaSensorType": {
      "type": "string",
      "description": "GEISA-defined sensor type for interoperability.",
      "enum": [
        "temperature",
        "humidity",
        "pressure",
        "voltage",
        "current",
        "power",
        "energy",
        "contact-state",
        "tamper",
        "tilt",
        "vibration",
        "geolocation",
        "micro-arc",
        "seismic",
        "custom"
      ]
    },
    "geolocation": {
      "$comment": "Optional geospatial location for sensors or devices that provide GPS or other coordinate-based positioning. This is distinct from service point, customer address, or other upstream PII-associated data.",
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitude-m": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "sensorValue": {
      "$comment": "Generic scalar value model for lower-rate sensor observations. High-frequency waveform-style data is handled by the Waveform API rather than this schema.",
      "type": "object",
      "properties": {
        "double-value": {
          "type": "number"
        },
        "int64-value": {
          "type": "integer"
        },
        "bool-value": {
          "type": "boolean"
        },
        "string-value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "double-value"
          ]
        },
        {
          "required": [
            "int64-value"
          ]
        },
        {
          "required": [
            "bool-value"
          ]
        },
        {
          "required": [
            "string-value"
          ]
        }
      ]
    },
    "sensorReading": {
      "type": "object",
      "required": [
        "sensor-id",
        "timestamp-ms",
        "value"
      ],
      "properties": {
        "sensor-id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp-ms": {
          "description": "UTC epoch time in milliseconds indicating when the reading was generated.",
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "$ref": "#/$defs/sensorValue"
        },
        "unit": {
          "description": "Engineering unit associated with the reading. If omitted, the descriptor unit applies.",
          "type": "string",
          "minLength": 1
        },
        "quality": {
          "description": "Optional quality indicator supplied by the platform.",
          "type": "string",
          "minLength": 1
        },
        "status": {
          "description": "Optional status text associated with the reading.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "geisa-sensor"
  ],
  "properties": {
    "geisa-sensor": {
      "type": "object",
      "required": [
        "sensor"
      ],
      "properties": {
        "sensor": {
          "type": "object",
          "required": [
            "sensor-id",
            "sensor-type",
            "unit",
            "supports-read",
            "supports-publish"
          ],
          "properties": {
            "sensor-id": {
              "description": "Platform-local identifier for the sensor.",
              "type": "string",
              "minLength": 1
            },
            "sensor-type": {
              "$ref": "#/$defs/geisaSensorType"
            },
            "sensor-subtype": {
              "description": "Optional platform-specific refinement of the GEISA sensor type.",
              "type": "string",
              "minLength": 1
            },
            "custom-sensor-type": {
              "description": "Implementation-specific sensor type used only when sensor-type is custom.",
              "type": "string",
              "minLength": 1
            },
            "name": {
              "description": "Optional display name for the sensor.",
              "type": "string",
              "minLength": 1
            },
            "description": {
              "description": "Optional human-readable description of the sensor.",
              "type": "string",
              "minLength": 1
            },
            "manufacturer": {
              "description": "Optional manufacturer name for the sensor implementation, if available.",
              "type": "string",
              "minLength": 1
            },
            "model": {
              "description": "Optional model identifier for the sensor implementation, if available.",
              "type": "string",
              "minLength": 1
            },
            "geolocation": {
              "$ref": "#/$defs/geolocation"
            },
            "unit": {
              "description": "Engineering unit used for reported values.",
              "type": "string",
              "minLength": 1
            },
            "supports-read": {
              "description": "Whether the sensor supports explicit read via the request/response API.",
              "type": "boolean"
            },
            "supports-publish": {
              "description": "Whether the platform may publish observations for this sensor.",
              "type": "boolean"
            },
            "min-report-period-ms": {
              "description": "Optional minimum platform-supported reporting period hint in milliseconds.",
              "type": "integer",
              "minimum": 0
            },
            "max-report-period-ms": {
              "description": "Optional maximum platform-supported reporting period hint in milliseconds.",
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "sensor-type": {
                    "const": "custom"
                  }
                },
                "required": [
                  "sensor-type"
                ]
              },
              "then": {
                "required": [
                  "custom-sensor-type"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "custom-sensor-type"
                  ]
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}